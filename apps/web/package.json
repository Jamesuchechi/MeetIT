{
  "name": "@meetit/web",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @meetit/protocol build && pnpm --filter @meetit/media build && pnpm --filter @meetit/ui build",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@meetit/media": "workspace:*",
    "@meetit/protocol": "workspace:*",
    "@meetit/ui": "workspace:*",
    "@sentry/react": "^11.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
